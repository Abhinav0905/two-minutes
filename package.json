{
  "name": "two-minutes-specs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two Minutes: Know When to Leave, a SPECS kitchen fire practice drill.",
  "scripts": {
    "web:build": "node scripts/build-web.mjs",
    "web:serve": "python3 -m http.server 8765 --bind 127.0.0.1 --directory docs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --project tsconfig.core.json --noEmit",
    "lens:tools": "node scripts/lens-mcp.mjs list",
    "lens:compile": "node scripts/lens-mcp.mjs call RecompileTypeScriptTool '{}'"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
